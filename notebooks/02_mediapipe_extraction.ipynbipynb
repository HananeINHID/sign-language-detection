es frames\n","170     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/66752.mp4     water  ATTENTION : mains non détectées sur 43% des frames\n","171     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/62499.mp4     water  ATTENTION : mains non détectées sur 45% des frames\n","172     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/62510.mp4     water  ATTENTION : mains non détectées sur 64% des frames\n","173     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/62500.mp4     water  ATTENTION : mains non détectées sur 48% des frames\n","174     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/62501.mp4     water  ATTENTION : mains non détectées sur 59% des frames\n","175     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/62502.mp4     water  ATTENTION : mains non détectées sur 39% des frames\n","176     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/water/62503.mp4     water  ATTENTION : mains non détectées sur 33% des frames\n","177     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/sleep/69479.mp4     sleep  ATTENTION : mains non détectées sur 29% des frames\n","178     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/sleep/52324.mp4     sleep  ATTENTION : mains non détectées sur 72% des frames\n","179     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/sleep/52316.mp4     sleep  ATTENTION : mains non détectées sur 40% des frames\n","181     /content/drive/MyDrive/Projets/sign-language-detection/data/raw/sleep/52318.mp4     sleep  ATTENTION : mains non détectées sur 47% des frames\n","183  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/66111.mp4  medicine  ATTENTION : mains non détectées sur 38% des frames\n","184  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/35454.mp4  medicine  ATTENTION : mains non détectées sur 47% des frames\n","185  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/35455.mp4  medicine  ATTENTION : mains non détectées sur 24% des frames\n","186  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/35456.mp4  medicine  ATTENTION : mains non détectées sur 59% des frames\n","188  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/35452.mp4  medicine  ATTENTION : mains non détectées sur 59% des frames\n","189  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/35467.mp4  medicine  ATTENTION : mains non détectées sur 61% des frames\n","190  /content/drive/MyDrive/Projets/sign-language-detection/data/raw/medicine/35453.mp4  medicine  ATTENTION : mains non détectées sur 47% des frames\n"]}]},{"cell_type":"code","source":["import cv2\n","import mediapipe as mp\n","from IPython.display import Video\n","import os\n","\n","mp_holistic = mp.solutions.holistic\n","mp_drawing  = mp.solutions.drawing_utils\n","\n","# Prends la première vidéo en warning\n","first_warning = warnings.iloc[0]['video_path']\n","print(f\"Vidéo inspectée : {first_warning}\")\n","\n","cap = cv2.VideoCapture(first_warning)\n","out_path = '/content/sample_debug.mp4'\n","fps = cap.get(cv2.CAP_PROP_FPS) or 25\n","w   = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n","h   = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n","out = cv2.VideoWriter(out_path, cv2.VideoWriter_fourcc(*'mp4v'), fps, (w, h))\n","\n","with mp_holistic.Holistic(min_detection_confidence=0.5,\n","                           min_tracking_confidence=0.5) as holistic:\n","    while cap.isOpened():\n","        ret, frame = cap.read()\n","        if not ret:\n","            break\n","        image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n","        results = holistic.process(image)\n","        image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)\n","\n","        # Dessine les landmarks visibles\n","        if results.left_hand_landmarks:\n","            mp_drawing.draw_landmarks(image, results.left_hand_landmarks,\n","                                      mp_holistic.HAND_CONNECTIONS)\n","        if results.right_hand_landmarks:\n","            mp_drawing.draw_landmarks(image, results.right_hand_landmarks,\n","                                      mp_holistic.HAND_CONNECTIONS)\n","        if results.pose_landmarks:\n","            mp_drawing.draw_landmarks(image, results.pose_landmarks,\n","                                      mp_holistic.POSE_CONNECTIONS)\n","        out.write(image)\n","\n","cap.release()\n","out.release()\n","Video(out_path, embed=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":243},"id":"j3kq-TJlBrd8","executionInfo":{"status":"ok","timestamp":1775388110691,"user_tz":-60,"elapsed":10307,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"7033fa92-02ac-4bb2-8e3f-f3eef938b018"},"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["Vidéo inspectée : /content/drive/MyDrive/Projets/sign-language-detection/data/raw/eat/69307.mp4\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/google/protobuf/symbol_database.py:55: UserWarning: SymbolDatabase.GetPrototype() is deprecated. Please use message_factory.GetMessageClass() instead. SymbolDatabase.GetPrototype() will be removed soon.\n","  warnings.warn('SymbolDatabase.GetPrototype() is deprecated. Please '\n"]},{"output_type":"execute_result","data":{"text/plain":["<IPython.core.display.Video object>"],"text/html":["<video controls  >\n"," <source src=\"data:video/mp4;base64,\" type=\"video/mp4\">\n"," Your browser does not support the video tag.\n"," </video>"]},"metadata":{},"execution_count":21}]},{"cell_type":"code","source":["import pandas as pd\n","\n","log = pd.read_csv('/content/drive/MyDrive/Projets/sign-language-detection/docs/data_log.csv')\n","\n","print(\"=== Warnings par classe ===\")\n","warnings = log[log['status'] == 'WARNING']\n","print(warnings['label'].value_counts())\n","\n","print(\"\\n=== Taux d'échec moyen par classe ===\")\n","# Extrait le % depuis la colonne note\n","import re\n","def extract_pct(note):\n","    match = re.search(r'(\\d+)%', str(note))\n","    return int(match.group(1)) if match else None\n","\n","warnings['taux'] = warnings['note'].apply(extract_pct)\n","print(warnings.groupby('label')['taux'].mean().round(1))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ysrdovBhI6kS","executionInfo":{"status":"ok","timestamp":1775388110711,"user_tz":-60,"elapsed":16,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"f286b253-20c6-4b1f-b8d2-91b932794183"},"execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["=== Warnings par classe ===\n","label\n","drink       16\n","eat         12\n","water        7\n","medicine     7\n","sleep        4\n","Name: count, dtype: int64\n","\n","=== Taux d'échec moyen par classe ===\n","label\n","drink       45.6\n","eat         53.5\n","medicine    47.9\n","sleep       47.0\n","water       47.3\n","Name: taux, dtype: float64\n"]},{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_17509/3299752561.py:16: SettingWithCopyWarning: \n","A value is trying to be set on a copy of a slice from a DataFrame.\n","Try using .loc[row_indexer,col_indexer] = value instead\n","\n","See the caveats in the documentation: https://pandas.pydata.org/pandas-docs/stable/user_guide/indexing.html#returning-a-view-versus-a-copy\n","  warnings['taux'] = warnings['note'].apply(extract_pct)\n"]}]},{"cell_type":"code","source":["import cv2, mediapipe as mp\n","import numpy as np\n","import matplotlib.pyplot as plt\n","\n","# Prend une vidéo warning de \"eat\"\n","eat_warnings = log[(log['status'] == 'WARNING') & (log['label'] == 'eat')]\n","video_path   = eat_warnings.iloc[0]['video_path']\n","print(f\"Vidéo : {video_path}\")\n","\n","mp_holistic = mp.solutions.holistic\n","mp_drawing  = mp.solutions.drawing_utils\n","\n","cap         = cv2.VideoCapture(video_path)\n","total       = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n","\n","# On échantillonne 12 frames réparties sur toute la vidéo\n","indices_a_capturer = np.linspace(0, total - 1, 12).astype(int)\n","frames_capturees   = {}\n","\n","with mp_holistic.Holistic(min_detection_confidence=0.5,\n","                           min_tracking_confidence=0.5) as holistic:\n","    frame_idx = 0\n","    while cap.isOpened():\n","        ret, frame = cap.read()\n","        if not ret:\n","            break\n","        if frame_idx in indices_a_capturer:\n","            image   = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n","            results = holistic.process(image)\n","\n","            left_ok  = results.left_hand_landmarks  is not None\n","            right_ok = results.right_hand_landmarks is not None\n","\n","            # Dessine les landmarks si détectés\n","            if left_ok:\n","                mp_drawing.draw_landmarks(image, results.left_hand_landmarks,\n","                                          mp_holistic.HAND_CONNECTIONS)\n","            if right_ok:\n","                mp_drawing.draw_landmarks(image, results.right_hand_landmarks,\n","                                          mp_holistic.HAND_CONNECTIONS)\n","            if results.pose_landmarks:\n","                mp_drawing.draw_landmarks(image, results.pose_landmarks,\n","                                          mp_holistic.POSE_CONNECTIONS)\n","\n","            frames_capturees[frame_idx] = {\n","                'image'   : image,\n","                'left_ok' : left_ok,\n","                'right_ok': right_ok\n","            }\n","        frame_idx += 1\n","\n","cap.release()\n","\n","# ── Affichage grille 3×4 ──────────────────────────────────────────\n","fig, axes = plt.subplots(3, 4, figsize=(16, 10))\n","fig.suptitle(f'Inspection détection mains — {video_path.split(\"/\")[-1]}',\n","             fontsize=13)\n","\n","for ax, (fidx, data) in zip(axes.flatten(), frames_capturees.items()):\n","    ax.imshow(data['image'])\n","\n","    left_ok  = data['left_ok']\n","    right_ok = data['right_ok']\n","    detected = left_ok or right_ok\n","\n","    # Titre coloré : vert = détecté, rouge = raté\n","    label = f\"Frame {fidx}\\nL:{'✓' if left_ok else '✗'}  R:{'✓' if right_ok else '✗'}\"\n","    color = 'green' if detected else 'red'\n","    ax.set_title(label, color=color, fontsize=9)\n","    ax.axis('off')\n","\n","    # Bordure colorée autour de la frame\n","    for spine in ax.spines.values():\n","        spine.set_edgecolor(color)\n","        spine.set_linewidth(3)\n","        spine.set_visible(True)\n","\n","plt.tight_layout()\n","plt.savefig('/content/debug_frames.png', dpi=120, bbox_inches='tight')\n","plt.show()\n","print(\"Image sauvegardée : /content/debug_frames.png\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":546},"id":"MH8WyPNUJgtU","executionInfo":{"status":"ok","timestamp":1775388116180,"user_tz":-60,"elapsed":5467,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"782b138a-2052-40e8-e353-f57296737d9e"},"execution_count":23,"outputs":[{"output_type":"stream","name":"stdout","text":["Vidéo : /content/drive/MyDrive/Projets/sign-language-detection/data/raw/eat/69307.mp4\n"]},{"output_type":"stream","name":"stderr","text":["/usr/local/lib/python3.12/dist-packages/google/protobuf/symbol_database.py:55: UserWarning: SymbolDatabase.GetPrototype() is deprecated. Please use message_factory.GetMessageClass() instead. SymbolDatabase.GetPrototype() will be removed soon.\n","  warnings.warn('SymbolDatabase.GetPrototype() is deprecated. Please '\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1000 with 12 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Image sauvegardée : /content/debug_frames.png\n"]}]},{"cell_type":"code","source":["import shutil, os\n","\n","LAND_DIR = '/content/drive/MyDrive/Projets/sign-language-detection/01_Landmarks'\n","CLASSES  = ['eat', 'drink', 'water', 'sleep', 'medicine']\n","\n","for cls in CLASSES:\n","    cls_dir = os.path.join(LAND_DIR, cls)\n","    if os.path.isdir(cls_dir):\n","        shutil.rmtree(cls_dir)\n","        print(f\"[CLEAN] {cls} supprimé\")\n","\n","LOG_PATH = '/content/drive/MyDrive/Projets/sign-language-detection/docs/data_log.csv'\n","if os.path.exists(LOG_PATH):\n","    os.remove(LOG_PATH)\n","    print(\"[CLEAN] data_log.csv réinitialisé\")\n","\n","print(\"\\nPrêt pour une extraction propre ✓\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Xr6OEfa2JxYb","executionInfo":{"status":"ok","timestamp":1775388117186,"user_tz":-60,"elapsed":989,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"b4275e87-580b-4897-e542-6f88510e3de9"},"execution_count":24,"outputs":[{"output_type":"stream","name":"stdout","text":["[CLEAN] eat supprimé\n","[CLEAN] drink supprimé\n","[CLEAN] water supprimé\n","[CLEAN] sleep supprimé\n","[CLEAN] medicine supprimé\n","[CLEAN] data_log.csv réinitialisé\n","\n","Prêt pour une extraction propre ✓\n"]}]},{"cell_type":"code","source":["import os, cv2, csv, numpy as np\n","import mediapipe as mp\n","from tqdm import tqdm\n","\n","# Config\n","DRIVE_BASE    = '/content/drive/MyDrive/Projets/sign-language-detection'\n","RAW_DIR       = f'{DRIVE_BASE}/data/raw'\n","OUTPUT_DIR    = f'{DRIVE_BASE}/01_Landmarks'\n","LOG_PATH      = f'{DRIVE_BASE}/docs/data_log.csv'\n","TARGET_FRAMES = 64\n","CLASSES       = ['eat', 'drink', 'water', 'sleep', 'medicine']\n","\n","os.makedirs(OUTPUT_DIR, exist_ok=True)\n","mp_holistic = mp.solutions.holistic\n","\n","\n","def extract_keypoints(results):\n","    \"\"\"1662 features : Pose(132) + Face(1404) + MainG(63) + MainD(63)\"\"\"\n","    pose = (np.array([[lm.x, lm.y, lm.z, lm.visibility]\n","                      for lm in results.pose_landmarks.landmark]).flatten()\n","            if results.pose_landmarks else np.zeros(33 * 4))\n","    face = (np.array([[lm.x, lm.y, lm.z]\n","                      for lm in results.face_landmarks.landmark]).flatten()\n","            if results.face_landmarks else np.zeros(468 * 3))\n","    left  = (np.array([[lm.x, lm.y, lm.z]\n","                       for lm in results.left_hand_landmarks.landmark]).flatten()\n","             if results.left_hand_landmarks else np.zeros(21 * 3))\n","    right = (np.array([[lm.x, lm.y, lm.z]\n","                       for lm in results.right_hand_landmarks.landmark]).flatten()\n","             if results.right_hand_landmarks else np.zeros(21 * 3))\n","    return np.concatenate([pose, face, left, right])\n","\n","\n","def trim_sequence(sequence, threshold=0.01):\n","    \"\"\"\n","    Supprime les frames vides (sans activité des mains)\n","    au début et à la fin de la séquence.\n","    Indices des mains : 132 + 1404 = 1536 → fin\n","    \"\"\"\n","    hand_features = sequence[:, 1536:]\n","    energy        = np.abs(hand_features).sum(axis=1)\n","    active"],"metadata":{"id":"p7EqunGPJzbl","executionInfo":{"status":"ok","timestamp":1775388117205,"user_tz":-60,"elapsed":16,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}}},"execution_count":25,"outputs":[]},{"cell_type":"code","source":["success_count = fail_count = 0\n","\n","for class_name in CLASSES:\n","    class_dir = os.path.join(RAW_DIR, class_name)\n","    if not os.path.isdir(class_dir):\n","        print(f\"[SKIP] {class_dir} introuvable\")\n","        continue\n","\n","    videos  = [f for f in os.listdir(class_dir)\n","               if f.lower().endswith(('.mp4', '.avi', '.mov'))]\n","    out_dir = os.path.join(OUTPUT_DIR, class_name)\n","    os.makedirs(out_dir, exist_ok=True)\n","\n","    print(f\"\\n▶ '{class_name}' — {len(videos)} vidéo(s)\")\n","\n","    for vf in tqdm(videos, desc=class_name):\n","        vpath    = os.path.join(class_dir, vf)\n","        sequence, note = process_video(vpath)\n","\n","        if sequence is None:\n","            log_result(vpath, class_name, 'FAILED', note)\n","            fail_count += 1\n","            continue\n","\n","        out_path = os.path.join(out_dir,\n","                                os.path.splitext(vf)[0] + '.npy')\n","        np.save(out_path, sequence)\n","        log_result(vpath, class_name, 'OK', note)\n","        success_count += 1\n","\n","# Rapport\n","total = success_count + fail_count\n","print(f\"\\nTraitement terminé. Total traité : {total} (Succès: {success_count}, Échecs: {fail_count})\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Lm6MPJEtJ2z4","executionInfo":{"status":"ok","timestamp":1775388782560,"user_tz":-60,"elapsed":665326,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"98156c6c-b877-4a23-986d-e1276591590c"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","▶ 'eat' — 7 vidéo(s)\n"]},{"output_type":"stream","name":"stderr","text":["eat: 100%|██████████| 7/7 [01:37<00:00, 13.90s/it]\n"]},{"output_type":"stream","name":"stdout","text":["\n","▶ 'drink' — 15 vidéo(s)\n"]},{"output_type":"stream","name":"stderr","text":["drink: 100%|██████████| 15/15 [03:04<00:00, 12.32s/it]\n"]},{"output_type":"stream","name":"stdout","text":["\n","▶ 'water' — 9 vidéo(s)\n"]},{"output_type":"stream","name":"stderr","text":["water: 100%|██████████| 9/9 [02:23<00:00, 15.93s/it]\n"]},{"output_type":"stream","name":"stdout","text":["\n","▶ 'sleep' — 6 vidéo(s)\n"]},{"output_type":"stream","name":"stderr","text":["sleep: 100%|██████████| 6/6 [01:27<00:00, 14.67s/it]\n"]},{"output_type":"stream","name":"stdout","text":["\n","▶ 'medicine' — 8 vidéo(s)\n"]},{"output_type":"stream","name":"stderr","text":["medicine: 100%|██████████| 8/8 [02:31<00:00, 18.96s/it]"]},{"output_type":"stream","name":"stdout","text":["\n","Traitement terminé. Total traité : 45 (Succès: 45, Échecs: 0)\n"]},{"output_typ