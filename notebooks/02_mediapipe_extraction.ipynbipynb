eady satisfied: python-dateutil>=2.7 in /usr/local/lib/python3.12/dist-packages (from matplotlib->mediapipe==0.10.14) (2.9.0.post0)\n","Requirement already satisfied: six>=1.5 in /usr/local/lib/python3.12/dist-packages (from python-dateutil>=2.7->matplotlib->mediapipe==0.10.14) (1.17.0)\n","Requirement already satisfied: pycparser in /usr/local/lib/python3.12/dist-packages (from cffi->sounddevice>=0.4.4->mediapipe==0.10.14) (3.0)\n","Using cached mediapipe-0.10.14-cp312-cp312-manylinux_2_17_x86_64.manylinux2014_x86_64.whl (35.7 MB)\n","Using cached protobuf-4.25.9-cp37-abi3-manylinux2014_x86_64.whl (295 kB)\n","Installing collected packages: protobuf, mediapipe\n","\u001b[31mERROR: pip's dependency resolver does not currently take into account all the packages that are installed. This behaviour is the source of the following dependency conflicts.\n","grpcio-status 1.71.2 requires protobuf<6.0dev,>=5.26.1, but you have protobuf 4.25.9 which is incompatible.\n","grain 0.2.16 requires protobuf>=5.28.3, but you have protobuf 4.25.9 which is incompatible.\n","opentelemetry-proto 1.38.0 requires protobuf<7.0,>=5.0, but you have protobuf 4.25.9 which is incompatible.\n","ydf 0.15.0 requires protobuf<7.0.0,>=5.29.1, but you have protobuf 4.25.9 which is incompatible.\u001b[0m\u001b[31m\n","\u001b[0mSuccessfully installed mediapipe-0.10.14 protobuf-4.25.9\n"]},{"output_type":"display_data","data":{"application/vnd.colab-display-data+json":{"pip_warning":{"packages":["google"]},"id":"c753cba44b7c4685a03b5f6d188cd1f7"}},"metadata":{}}]},{"cell_type":"code","source":["import os, cv2, numpy as np\n","from tqdm import tqdm\n","try:\n","    import mediapipe as mp\n","    print(f\"MediaPipe version {mp.__version__} importée avec succès.\")\n","except ImportError:\n","    print(\"Erreur d'importation. Veuillez vérifier l'exécution de la cellule d'installation ci-dessus.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"_36-7XV245Q6","executionInfo":{"status":"ok","timestamp":1775386444711,"user_tz":-60,"elapsed":6813,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"56ffbf0f-68af-46c3-e1dd-283b9a3a1078"},"execution_count":1,"outputs":[{"output_type":"stream","name":"stdout","text":["MediaPipe version 0.10.14 importée avec succès.\n"]}]},{"cell_type":"code","source":["!ls -l /content/drive/"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Vio5-7iwS-pv","executionInfo":{"status":"ok","timestamp":1775386852257,"user_tz":-60,"elapsed":123,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"8b3cf749-cafc-4ce7-b8b7-1709b1717c1c"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["total 4\n","drwxr-xr-x 3 root root 4096 Apr  5 10:53 MyDrive\n"]}]},{"cell_type":"code","source":["# 1. On détruit le \"faux\" dossier créé par erreur dans la machine virtuelle\n","!rm -rf /content/drive\n","\n","# 2. On force la reconnexion au VRAI Google Drive\n","from google.colab import drive\n","drive.mount('/content/drive', force_remount=True)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"oLDyCiKXTaln","executionInfo":{"status":"ok","timestamp":1775386885713,"user_tz":-60,"elapsed":19656,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"2804d06a-a26e-49f3-cbcb-87c1b3a4d805"},"execution_count":12,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["DRIVE_BASE    = '/content/drive/MyDrive/Projets/sign-language-detection'\n","RAW_DIR       = f'{DRIVE_BASE}/data/raw'\n","OUTPUT_DIR    = f'{DRIVE_BASE}/data/processed'\n","LOG_PATH      = f'{DRIVE_BASE}/docs/data_log.csv'\n","TARGET_FRAMES = 64\n","\n","CLASSES = ['eat', 'drink', 'water', 'sleep', 'medicine']\n","\n","# Création automatique des sous-dossiers pour chaque mot dans 'processed'\n","for mot in CLASSES:\n","    os.makedirs(os.path.join(OUTPUT_DIR, mot), exist_ok=True)\n","os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)\n","\n","print(f\"Configuration prête. Les données iront de {RAW_DIR} vers {OUTPUT_DIR}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"IMCTxidk47iH","executionInfo":{"status":"ok","timestamp":1775386895332,"user_tz":-60,"elapsed":3703,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"f0f9935a-1b1c-4ce5-ab30-f245a8c7283f"},"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Configuration prête. Les données iront de /content/drive/MyDrive/Projets/sign-language-detection/data/raw vers /content/drive/MyDrive/Projets/sign-language-detection/data/processed\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"PRlLiXvXTZd7"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import cv2, os\n","\n","RAW_DIR = '/content/drive/MyDrive/Projets/sign-language-detection/data/raw/'\n","CLASSES = ['eat', 'drink', 'water', 'sleep', 'medicine']\n","\n","if not os.path.exists(RAW_DIR):\n","    print(f\"❌ ERREUR : Le dossier principal {RAW_DIR} n'existe pas !\")\n","durations = []\n","for cls in CLASSES:\n","    cls_dir = os.path.join(RAW_DIR, cls)\n","    if not os.path.isdir(cls_dir):\n","        continue\n","    for f in os.listdir(cls_dir):\n","        if not f.endswith('.mp4'):\n","            continue\n","        cap = cv2.VideoCapture(os.path.join(cls_dir, f))\n","        fps    = cap.get(cv2.CAP_PROP_FPS) or 25\n","        frames = cap.get(cv2.CAP_PROP_FRAME_COUNT)\n","        durations.append(frames / fps)\n","        cap.release()\n","\n","import numpy as np\n","print(f\"Durée min  : {min(durations):.2f}s\")\n","print(f\"Durée max  : {max(durations):.2f}s\")\n","print(f\"Durée moy  : {np.mean(durations):.2f}s\")\n","print(f\"Médiane    : {np.median(durations):.2f}s\")\n","print(f\"\\n→ TARGET_FRAMES recommandé : {int(np.median(durations) * 25)}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"AZOhf-VmCU8f","executionInfo":{"status":"ok","timestamp":1775386944321,"user_tz":-60,"elapsed":44090,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"09949f24-d0e3-4dd6-bf6f-9bb35b886bb2"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Durée min  : 1.00s\n","Durée max  : 5.08s\n","Durée moy  : 2.61s\n","Médiane    : 2.57s\n","\n","→ TARGET_FRAMES recommandé : 64\n"]}]},{"cell_type":"code","source":["mp_holistic = mp.solutions.holistic\n","\n","def extract_keypoints(results):\n","    \"\"\"\n","    Extrait et concatène les landmarks en un vecteur 1D de 1662 valeurs.\n","\n","    Décomposition :\n","      - Pose       : 33 points × 4 (x, y, z, visibility) = 132\n","      - Face       : 468 points × 3 (x, y, z)            = 1404\n","      - Main gauche: 21 points × 3 (x, y, z)             =  63\n","      - Main droite: 21 points × 3 (x, y, z)             =  63\n","      ─────────────────────────────────────────────────────────\n","      Total                                               = 1662\n","\n","    Si une partie du corps n'est pas détectée (main hors cadre,\n","    visage coupé...), le vecteur correspondant est rempli de zéros.\n","    Cela évite les erreurs mais génère un warning dans le log.\n","    \"\"\"\n","    pose = (\n","        np.array([[lm.x, lm.y, lm.z, lm.visibility]\n","                  for lm in results.pose_landmarks.landmark]).flatten()\n","        if results.pose_landmarks\n","        else np.zeros(33 * 4)\n","    )\n","    face = (\n","        np.array([[lm.x, lm.y, lm.z]\n","                  for lm in results.face_landmarks.landmark]).flatten()\n","        if results.face_landmarks\n","        else np.zeros(468 * 3)\n","    )\n","    left_hand = (\n","        np.array([[lm.x, lm.y, lm.z]\n","                  for lm in results.left_hand_landmarks.landmark]).flatten()\n","        if results.left_hand_landmarks\n","        else np.zeros(21 * 3)\n","    )\n","    right_hand = (\n","        np.array([[lm.x, lm.y, lm.z]\n","                  for lm in results.right_hand_landmarks.landmark]).flatten()\n","        if results.right_hand_landmarks\n","        else np.zeros(21 * 3)\n","    )\n","\n","    return np.concatenate([pose, face, left_hand, right_hand])  # shape: (1662,)\n","\n","\n","def standardize_sequence(sequence, target=TARGET_FRAMES):\n","    \"\"\"\n","    Redimensionne une séquence à exactement `target` frames\n","    par rééchantillonnage linéaire des indices.\n","\n","    Exemples :\n","      - Vidéo de 45 frames → on sélectionne 30 frames régulièrement espacées\n","      - Vidéo de 12 frames → on duplique certaines frames pour atteindre 30\n","    \"\"\"\n","    n = len(sequence)\n","    if n == 0:\n","        return None\n","    indices = np.linspace(0, n - 1, target).astype(int)\n","    return np.array([sequence[i] for i in indices])  # shape: (30, 1662)\n","\n","\n","def process_video(video_path):\n","    \"\"\"\n","    Traite une vidéo complète et retourne une séquence (30, 1662).\n","\n","    Retourne None si :\n","      - Le fichier ne s'ouvre pas\n","      - Aucune frame n'a pu être extraite\n","\n","    Gestion des mains hors cadre :\n","      - Si une main disparaît sur quelques frames → vecteur de zéros pour ces frames\n","      - Si les deux mains sont absentes sur > 20% des frames → WARNING dans le log\n","    \"\"\"\n","    cap = cv2.VideoCapture(video_path)\n","    if not cap.isOpened():\n","        return None, \"Impossible d'ouvrir le fichier vidéo\"\n","\n","    sequence = []\n","    frames_sans_mains = 0\n","    total_frames = 0\n","\n","    with mp_holistic.Holistic(\n","      min_detection_confidence=0.3, # On baisse la barre pour être plus tolérant\n","      min_tracking_confidence=0.3,\n","      model_complexity=2            # On passe de 1 à 2 (plus lent mais plus précis)\n","    ) as holistic:\n","\n","        while cap.isOpened():\n","            ret, frame = cap.read()\n","            if not ret:\n","                break\n","\n","            total_frames += 1\n","\n","            # MediaPipe travaille en RGB, OpenCV lit en BGR\n","            image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)\n","            image.flags.writeable = False\n","            results = holistic.process(image)\n","\n","            # Comptage des frames sans mains détectées\n","            if (results.left_hand_landmarks is None\n","                    and results.right_hand_landmarks is None):\n","                frames_sans_mains += 1\n","\n","            keypoints = extract_keypoints(results)\n","            sequence.append(keypoints)\n","\n","    cap.release()\n","\n","    if total_frames == 0:\n","        return None, \"Vidéo vide ou illisible\"\n","\n","    # Calcul du taux d'échec de détection des mains\n","    taux_echec = frames_sans_mains / total_frames\n","    warning = \"\"\n","    if taux_echec > 0.20:\n","        warning = f\"ATTENTION : mains non détectées sur {taux_echec:.0%} des frames\"\n","\n","    # Standardisation à TARGET_FRAMES\n","    sequence_std = standardize_sequence(sequence)\n","    return sequence_std, warning\n"],"metadata":{"id":"muRTDbLZ5Kjg","executionInfo":{"status":"ok","timestamp":1775387092303,"user_tz":-60,"elapsed":63,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}}},"execution_count":15,"outputs":[]},{"cell_type":"code","source":["import csv\n","\n","def log_result(video_path, label, status, note=\"\"):\n","    \"\"\"Enregistre chaque résultat dans le CSV de qualité.\"\"\"\n","    write_header = not os.path.exists(LOG_PATH)\n","    with open(LOG_PATH, 'a', newline='') as f:\n","        writer = csv.writer(f)\n","        if write_header:\n","            writer.writerow(['video_path', 'label', 'status', 'note'])\n","        writer.writerow([video_path, label, status, note])"],"metadata":{"id":"zeOFWUy2-_VC","executionInfo":{"status":"ok","timestamp":1775387096195,"user_tz":-60,"elapsed":13,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}}},"execution_count":16,"outputs":[]},{"cell_type":"code","source":["success_count = 0\n","fail_count    = 0\n","warning_count = 0\n","\n","for class_name in CLASSES:\n","    class_dir = os.path.join(RAW_DIR, class_name)\n","\n","    if not os.path.isdir(class_dir):\n","        print(f\"[SKIP] Dossier introuvable : {class_dir}\")\n","        continue\n","\n","    videos = [f for f in os.listdir(class_dir)\n","              if f.lower().endswith(('.mp4', '.avi', '.mov'))]\n","\n","    print(f\"\\n▶ Classe '{class_name}' — {len(videos)} vidéo(s)\")\n","\n","    out_dir = os.path.join(OUTPUT_DIR, class_name)\n","    os.makedirs(out_dir, exist_ok=True)\n","\n","    for video_file in tqdm(videos, desc=class_name):\n","        video_path = os.path.join(class_dir, video_file)\n","        sequence, note = process_video(video_path)\n","\n","        if sequence is None:\n","            print(f\"  [ERREUR] {video_file} → {note}\")\n","            log_result(video_path, class_name, 'FAILED', note)\n","            fail_count += 1\n","            continue\n","\n","        # Sauvegarde : même nom que la vidéo, extension .npy\n","        out_name = os.path.splitext(video_file)[0] + '.npy'\n","        out_path = os.path.join(out_dir, out_name)\n","        np.save(out_path, sequence)\n","\n","        if note:\n","            print(f\"  [WARN]  {video_file} → {note}\")\n","            log_result(video_path, class_name, 'WARNING', note)\n","            warning_count += 1\n","        else:\n","            log_result(video_path, class_name, 'OK')\n","            success_count += 1"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"vpGCMSEl9Rrw","executionInfo":{"status":"ok","timestamp":1775388003650,"user_tz":-60,"elapsed":706286,"user":{"displayName":"hanane inhid","userId":"05071136086480428913"}},"outputId":"a37f96bb-b89e-426f-f4aa-a1ffa18d7d0a"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["\n